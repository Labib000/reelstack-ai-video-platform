# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
LOG_LEVEL=

# Infrastructure (docker compose defaults)
MONGO_URI=mongodb://localhost:27017/reelstack
REDIS_URL=redis://localhost:6379

# Auth: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7

# Object storage: RustFS (S3-compatible) locally, Cloudflare R2 in production
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reelstack
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
# The storage URL browsers upload to (presigned URLs are signed for it). Blank = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
# Largest upload allowed, in bytes (default 5 GB).
UPLOAD_MAX_BYTES=
# Where the worker keeps files while transcoding. Needs real disk space, so not a RAM-backed /tmp.
# Blank = .transcode/ in the repo.
TRANSCODE_DIR=
# Signs playback links. Blank = derived from JWT_ACCESS_SECRET.
PLAYBACK_TOKEN_SECRET=

# Groq (Whisper transcription + LLM for Ask the Video)
GROQ_API_KEY=

# mongo-express web UI (http://localhost:8081)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=reelstack
