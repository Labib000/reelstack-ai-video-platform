# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173
LOG_LEVEL=

# Infrastructure (docker compose defaults)
MONGO_URI=mongodb://localhost:27017/reelstack
REDIS_URL=redis://localhost:6379

# Auth: generate with `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_DAYS=7

# Object storage: MinIO locally, Cloudflare R2 in production
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=reelstack
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Groq (Whisper transcription + LLM for Ask the Video)
GROQ_API_KEY=
